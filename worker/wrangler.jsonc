{
  // Telegram bot Vency. Nasazuje ho úloha .github/workflows/bot.yml (wrangler deploy),
  // tajné údaje (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, BOT_GITHUB_TOKEN) nahraje tamtéž.
  "name": "venca-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "GITHUB_REPO": "Kosta-CZ/venca-stamgast",
    // Rozvrh pozastavený (rozhodnutí majitele 19. 11. 2026): bot sám nic nespouští.
    // Znovu zapnout: "false" a push do main (bot.yml bota nasadí sám).
    "PAUSED": "true"
  },
  "observability": {
    "enabled": true
  },
  // Plánovač: bot se budí v těchto minutách každé hodiny (UTC) a spustí úlohy z rozvrhu PLAN
  // v src/index.ts. Nový čas v jiné minutě = přidat minutu sem.
  "triggers": {
    "crons": ["10,23,41,53 * * * *"]
  }
}
